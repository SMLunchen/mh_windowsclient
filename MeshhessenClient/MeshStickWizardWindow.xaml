<Window x:Class="MeshhessenClient.MeshStickWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StrMstTitle}"
        Width="800" Height="660"
        MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="MstSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="MstHint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="MstWarnBox" TargetType="Border">
            <Setter Property="Background" Value="#FFF4D6"/>
            <Setter Property="BorderBrush" Value="#E0A800"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="MstInfoBox" TargetType="Border">
            <Setter Property="Background" Value="#E8F1FB"/>
            <Setter Property="BorderBrush" Value="#1E6AB8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="MstOkBox" TargetType="Border">
            <Setter Property="Background" Value="#E6F4EA"/>
            <Setter Property="BorderBrush" Value="#198754"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="MstLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MstValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MstLog" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="110"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Border Grid.Row="0" Background="#1E3A5F" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StepTitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="StepIndicatorText" Grid.Column="1" Foreground="#A0C4E8" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── PAGES ── -->
        <Grid Grid.Row="1">

            <!-- PAGE 1: Requirements, stick & driver -->
            <ScrollViewer x:Name="Page1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <Border Style="{StaticResource MstInfoBox}">
                        <TextBlock Text="{DynamicResource StrMstRequirements}" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{DynamicResource StrMstStickSection}" Style="{StaticResource MstSectionTitle}"/>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource StrMstLblInternet}" Style="{StaticResource MstLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InternetStatusText" Style="{StaticResource MstValue}"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource StrMstLblStick}" Style="{StaticResource MstLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StickStatusText" Style="{StaticResource MstValue}"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource StrMstLblDetails}" Style="{StaticResource MstLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StickDetailText" Style="{StaticResource MstValue}" FontWeight="Normal" Foreground="#666"/>
                        </Grid>
                    </Border>

                    <Border x:Name="DriverBox" Style="{StaticResource MstWarnBox}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StrMstDriverHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button x:Name="InstallBundledBtn" Padding="10,4" Margin="0,0,8,6" FontWeight="SemiBold" Click="InstallBundled_Click"/>
                                <Button x:Name="OpenWchBtn" Content="{DynamicResource StrMstOpenWch}" Padding="10,4" Margin="0,0,8,6" Click="OpenWch_Click"/>
                                <Button x:Name="InstallFoundBtn" Padding="10,4" Margin="0,0,8,6" Click="InstallFound_Click" Visibility="Collapsed" FontWeight="SemiBold"/>
                                <Button x:Name="PickDriverBtn" Content="{DynamicResource StrMstPickDriver}" Padding="10,4" Margin="0,0,8,6" Click="PickDriver_Click"/>
                                <Button x:Name="RecheckBtn" Content="{DynamicResource StrMstRecheck}" Padding="10,4" Margin="0,0,8,6" Click="Recheck_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="DriverStatusText" TextWrapping="Wrap" Foreground="#555"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StickOkBox" Style="{StaticResource MstOkBox}" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource StrMstStickReadyHint}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 2: get meshtasticd -->
            <ScrollViewer x:Name="Page2" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource StrMstDaemonSection}" Style="{StaticResource MstSectionTitle}"/>
                    <TextBlock Text="{DynamicResource StrMstDaemonHint}" Style="{StaticResource MstHint}"/>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <TextBlock x:Name="DaemonStatusText" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{DynamicResource StrMstSourceSection}" Style="{StaticResource MstSectionTitle}"/>
                    <RadioButton x:Name="SourceMirrorRadio" GroupName="MstSource" Margin="0,0,0,4" IsChecked="True" Checked="Source_Changed"/>
                    <RadioButton x:Name="SourceOfficialRadio" GroupName="MstSource" Content="{DynamicResource StrMstSourceOfficial}" Margin="0,0,0,4" Checked="Source_Changed"/>
                    <RadioButton x:Name="SourceLocalRadio" GroupName="MstSource" Content="{DynamicResource StrMstSourceLocal}" Margin="0,0,0,8" Checked="Source_Changed"/>

                    <Grid x:Name="ReleasePanel" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ReleaseCombo" MinHeight="30" SelectionChanged="Release_Changed"/>
                        <Button x:Name="RefreshReleasesBtn" Grid.Column="1" Content="{DynamicResource StrMstRefreshReleases}" Margin="8,0,0,0" Padding="10,4" Click="RefreshReleases_Click"/>
                    </Grid>
                    <TextBlock x:Name="ReleasesStatusText" Style="{StaticResource MstHint}"/>

                    <Grid x:Name="LocalPanel" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LocalMsiBox" IsReadOnly="True" MinHeight="30" VerticalContentAlignment="Center"/>
                        <Button x:Name="BrowseMsiBtn" Grid.Column="1" Content="{DynamicResource StrMstBrowseMsi}" Margin="8,0,0,0" Padding="10,4" Click="BrowseMsi_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <Button x:Name="DownloadBtn" Content="{DynamicResource StrMstDownload}" Padding="14,6" Click="Download_Click"/>
                        <TextBlock x:Name="DownloadStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressBar x:Name="DownloadProgress" Height="14" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <CheckBox x:Name="SkipInstallCheck" Content="{DynamicResource StrMstSkipInstall}" IsEnabled="False" Checked="SkipInstall_Changed" Unchecked="SkipInstall_Changed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 3: config & service -->
            <Grid x:Name="Page3" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource MstInfoBox}">
                    <TextBlock Text="{DynamicResource StrMstSetupHint}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource StrMstPortLabel}" Style="{StaticResource MstLabel}"/>
                    <TextBox x:Name="ApiPortBox" Width="90" TextChanged="ApiPort_Changed"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{DynamicResource StrMstConfigPreview}" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox Grid.Row="3" x:Name="ConfigPreviewBox" Style="{StaticResource MstLog}" MaxHeight="190" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="4" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SetupBtn" Content="{DynamicResource StrMstSetupBtn}" Padding="14,6" FontWeight="SemiBold" Click="Setup_Click"/>
                        <Button x:Name="ProbeDaemonBtn" Content="{DynamicResource StrMstProbeBtn}" Padding="10,6" Margin="8,0,0,0" Click="ProbeDaemon_Click"/>
                        <TextBlock x:Name="SetupStatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressBar x:Name="SetupProgress" Height="14" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                </StackPanel>
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource StrMstLog}" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1" x:Name="SetupLogBox" Style="{StaticResource MstLog}"/>
                </Grid>
            </Grid>

            <!-- PAGE 4: connect -->
            <ScrollViewer x:Name="Page4" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource StrMstConnectHint}" Style="{StaticResource MstHint}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="ConnectBtn" Content="{DynamicResource StrMstConnectBtn}" Padding="14,6" FontWeight="SemiBold" Click="Connect_Click"/>
                        <TextBlock x:Name="ConnectStatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border x:Name="NodeInfoBox" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource StrMstLblNode}" Style="{StaticResource MstLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NodeNameText" Style="{StaticResource MstValue}"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource StrMstLblFirmware}" Style="{StaticResource MstLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NodeFwText" Style="{StaticResource MstValue}"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource StrMstLblEndpoint}" Style="{StaticResource MstLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="NodeEndpointText" Style="{StaticResource MstValue}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 5: LoRa settings -->
            <Grid x:Name="Page5" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource StrMstLoraHint}" Style="{StaticResource MstHint}"/>
                <Border Grid.Row="1" Style="{StaticResource MstOkBox}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource StrMstMeshHessenHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button x:Name="MeshHessenBtn" Content="{DynamicResource StrMstMeshHessenBtn}" HorizontalAlignment="Left"
                                Padding="16,8" Background="#FF2E7D32" Foreground="White" FontWeight="Bold" Click="MeshHessen_Click"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource StrMstRegion}" Style="{StaticResource MstLabel}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="RegionCombo" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource StrMstHopLimit}" Style="{StaticResource MstLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="4" x:Name="HopLimitBox" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource StrMstPreset}" Style="{StaticResource MstLabel}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PresetCombo" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource StrMstTxPower}" Style="{StaticResource MstLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="TxPowerBox" Margin="0,0,0,6"/>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="SaveLoraBtn" Content="{DynamicResource StrMstSaveLora}" Padding="14,6" Click="SaveLora_Click"/>
                    <TextBlock x:Name="LoraStatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource StrMstLog}" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1" x:Name="LoraLogBox" Style="{StaticResource MstLog}"/>
                </Grid>
            </Grid>

            <!-- PAGE 6: done -->
            <ScrollViewer x:Name="Page6" VerticalScrollBarVisibility="Auto" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource MstOkBox}">
                        <TextBlock x:Name="DoneText" FontSize="14" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="DoneDetailText" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="OpenWorkDirBtn" Content="{DynamicResource StrMstOpenWorkDir}" HorizontalAlignment="Left" Padding="10,4" Click="OpenWorkDir_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── FOOTER ── -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Foreground="#666" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="BackBtn" Grid.Column="1" Content="{DynamicResource StrMstBack}" Padding="14,6" Margin="0,0,8,0" Click="Back_Click"/>
                <Button x:Name="NextBtn" Grid.Column="2" Content="{DynamicResource StrMstNext}" Padding="14,6" Margin="0,0,8,0" Click="Next_Click"/>
                <Button x:Name="CancelBtn" Grid.Column="3" Content="{DynamicResource StrMstCancel}" Padding="14,6" Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
