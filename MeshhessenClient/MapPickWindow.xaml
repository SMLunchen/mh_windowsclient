<Window x:Class="MeshhessenClient.MapPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="{DynamicResource StrLinkProfileTitle}" Height="520" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HintText" Grid.Row="0" Margin="10,8,10,8"
                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <mapsui:MapControl x:Name="PickMap" Grid.Row="1" Cursor="Cross"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,8,10,8">
            <TextBlock x:Name="CoordText" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7" FontSize="11"/>
            <Button Content="{DynamicResource StrCancel}" Width="95" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
