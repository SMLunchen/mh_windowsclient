# Rechtstexte-Server (impressum.meshhessenclient.de) — Apache-Konfiguration.
# Ziel: nicht indexieren, nicht crawlen (Gürtel + Hosenträger zu robots.txt + <meta robots>).

# --- Suchmaschinen/Crawler per HTTP-Header aussperren (gilt für ALLE Antworten) ---
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"

    # Ein paar sinnvolle Sicherheits-Header für statische Rechtstexte
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# --- Bloße Subdomain liefert das Impressum aus ---
DirectoryIndex index.html

# --- Verzeichnis-Listing aus ---
Options -Indexes

# --- robots.txt ausliefern lassen (nicht durch obige Header-Regel „verstecken") ---
# (X-Robots-Tag betrifft die Indexierung, nicht die Erreichbarkeit — robots.txt bleibt abrufbar.)

# --- Optional: HTTP → HTTPS erzwingen (aktivieren, falls TLS eingerichtet ist) ---
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
